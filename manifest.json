{
  "manifest_version": 3,
  "name": "PixelPrism",
  "version": "0.1.50",
  "key": "",
  "description": "Inspect responsive layouts, measure elements, and fine-tune CSS visually.",
  "icons": {
    "16": "icons/pulse-16.png",
    "32": "icons/pulse-32.png",
    "48": "icons/pulse-48.png",
    "128": "icons/pulse-128.png"
  },
  "permissions": [
    "tabs",
    "downloads",
    "activeTab",
    "debugger",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open PixelPrism",
    "default_icon": {
      "16": "icons/pulse-16.png",
      "32": "icons/pulse-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "inspector/boot.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
